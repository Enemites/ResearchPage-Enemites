---
import type { StatItem } from '../content/home';

interface Props {
  item: StatItem;
}

const { item } = Astro.props;
---

<div class="stat-card animate-on-scroll" id={item.id}>
  <div class="stat-card__number" data-count={item.displayValue ? undefined : item.value}>
    {item.displayValue ?? item.value}
  </div>
  <div class="stat-card__label">{item.label}</div>
  <div class="stat-card__sublabel">{item.sublabel}</div>
</div>
