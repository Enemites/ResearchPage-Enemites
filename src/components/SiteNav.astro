---
import iconUrl from '../icon.svg';

interface Props {
  activeItem?: 'publications' | 'methodology';
  scrolled?: boolean;
}

const { activeItem, scrolled = false } = Astro.props;
const pubClass = ['nav__link', activeItem === 'publications' ? 'nav__link--active' : ''].filter(Boolean).join(' ');
const methodClass = ['nav__link', activeItem === 'methodology' ? 'nav__link--active' : ''].filter(Boolean).join(' ');
---

<nav class:list={['nav', { scrolled }]} id="nav">
  <div class="nav__inner">
    <a href="/" class="nav__logo">
      <div class="nav__logo-icon">
        <img src={iconUrl.src} alt="Enemites Logo" />
      </div>
      <span class="nav__logo-text">Enemites</span>
      <span class="nav__badge">Research</span>
    </a>

    <div class="nav__links">
      <a href="/#publications" class={pubClass} id="nav-publications">Publications</a>
      <a href="/#methodology" class={methodClass} id="nav-methodology">Methodology</a>
      <a href="https://enemites.com/profile" target="_blank" rel="noopener noreferrer" class="nav__link">Profile</a>
      <a href="mailto:support@enemites.com" class="nav__link">Contact</a>
      <a href="https://enemites.com/realms" target="_blank" rel="noopener noreferrer" class="nav__cta" id="nav-cta">
        Try Realms
      </a>
    </div>

    <button class="nav__hamburger" id="nav-hamburger" aria-label="Toggle mobile menu" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="nav__mobile-menu" id="nav-mobile-menu">
    <a href="/#publications" class={pubClass}>Publications</a>
    <a href="/#methodology" class={methodClass}>Methodology</a>
    <a href="https://enemites.com/profile" target="_blank" rel="noopener noreferrer" class="nav__link">Profile</a>
    <a href="mailto:support@enemites.com" class="nav__link">Contact</a>
    <a href="https://enemites.com/realms" target="_blank" rel="noopener noreferrer" class="nav__link nav__link--cta">
      Try Realms &rarr;
    </a>
  </div>
</nav>
