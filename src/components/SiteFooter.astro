---
import iconUrl from '../icon.svg';

export interface FooterLink {
  href: string;
  label: string;
  id?: string;
  external?: boolean;
}

interface Props {
  links: FooterLink[];
}

const { links } = Astro.props;
---

<footer class="footer">
  <div class="container">
    <div class="footer__inner">
      <div class="footer__brand">
        <a href="/" class="footer__logo" aria-label="Enemites Research Home">
          <img src={iconUrl.src} alt="" class="footer__logo-mark" />
          <span class="footer__logo-text">Enemites</span>
          <span class="footer__logo-sub">Research</span>
        </a>
        <p class="footer__copy">&copy; 2026 Enemites. All rights reserved.</p>
      </div>

      <div class="footer__links">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="footer__link"
              id={link.id}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
