---
import type { FooterLink } from '../components/SiteFooter.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav.astro';
import faviconUrl from '../favicon.svg';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: 'website' | 'article';
  ogUrl?: string;
  activeNav?: 'publications' | 'methodology';
  navScrolled?: boolean;
  footerLinks?: FooterLink[];
}

const {
  title,
  description,
  keywords,
  ogTitle = title,
  ogDescription = description,
  ogType = 'website',
  ogUrl,
  activeNav,
  navScrolled = false,
  footerLinks = [
    { href: 'https://enemites.com/profile', label: 'Enemites Profile', id: 'footer-profile', external: true },
    { href: 'https://enemites.com/realms', label: 'Realms', id: 'footer-realms', external: true },
    { href: '#publications', label: 'Publications' },
    { href: '#benchmarks', label: 'Benchmarks' },
    { href: '#methodology', label: 'Methodology' },
    { href: 'mailto:support@enemites.com', label: 'Contact', external: true },
  ],
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    {ogUrl && <meta property="og:url" content={ogUrl} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href={faviconUrl.src} />
  </head>
  <body>
    <SiteNav activeItem={activeNav} scrolled={navScrolled} />
    <slot />
    <SiteFooter links={footerLinks} />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
